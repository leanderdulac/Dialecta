# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# Fica só no servidor: é lida por api/analyze.ts e pelo dev server do Vite.
# Nunca use o prefixo VITE_ nesta chave — isso a exporia no navegador.
GEMINI_API_KEY=

# Opcional: sobrescreve o modelo usado nas análises.
GEMINI_MODEL=gemini-3.1-pro-preview
